{
  "expo": {
    "name": "Verdant",
    "slug": "verdant",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8494f27d-1809-463b-a02e-922d7110bbf2"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "verdant",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e5435"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.verdant.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Verdant necesita acceso a la red local para conectarse al servidor de desarrollo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e5435"
      },
      "package": "com.verdant.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2d7a4f"
        }
      ],
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8494f27d-1809-463b-a02e-922d7110bbf2"
      }
    },
    "owner": "juanbenitez10"
  }
}
