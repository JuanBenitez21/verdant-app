{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "update:prod": "eas update --channel production",
    "build:android": "eas build --platform android --profile preview-android",
    "build:dev": "eas build --platform ios --profile development"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.2.3",
    "@expo-google-fonts/dm-serif-display": "^0.2.3",
    "@expo/dom-webview": "~0.2.3",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.43.4",
    "@tanstack/react-query": "^5.45.1",
    "@verdant/shared": "workspace:*",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-device": "^56.0.4",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.9",
    "expo-notifications": "~0.32.13",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "nativewind": "^4.0.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "~0.5.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.8.3"
  }
